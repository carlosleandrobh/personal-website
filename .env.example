# Copy to `.env` (git-ignored). Used by `npm run dev` / `npm run build` and by `uv run cms`.
# Without Supabase values, `npm run dev` uses the content in supabase/seed/content.json.

# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...). Server-side only: CLI and build. Never in browser code.
SUPABASE_SECRET_KEY=

# --- Content preview (site build) ---
# auto | supabase | fixtures
CONTENT_SOURCE=auto
# true = show drafts locally (never set this in GitHub Actions)
INCLUDE_DRAFTS=false

# --- Public values (end up in the HTML on purpose) ---
PUBLIC_CONTACT_ENDPOINT=https://YOUR-PROJECT-REF.supabase.co/functions/v1/contact
PUBLIC_TURNSTILE_SITE_KEY=

# --- LinkedIn (uv run cms linkedin connect) ---
LINKEDIN_CLIENT_ID=
# Stays on your computer only — never in GitHub or Supabase
LINKEDIN_CLIENT_SECRET=
# openssl rand -base64 32 — same value as the GitHub secret LINKEDIN_TOKEN_KEY
LINKEDIN_TOKEN_KEY=
# Filled after the first connect (the command tells you the value)
LINKEDIN_EXPECTED_SUB=
# Recent LinkedIn API version, YYYYMM (LinkedIn retires old versions)
LINKEDIN_API_VERSION=202608

# --- GitHub repository sync (optional locally) ---
GITHUB_USERNAME=
