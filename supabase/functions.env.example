# Secrets for the `contact` Edge Function — the only server code on Supabase.
# Copy to supabase/.env.functions (git-ignored), fill in, then:
#   npx supabase secrets set --env-file supabase/.env.functions
# SUPABASE_URL and the service key are injected by Supabase automatically — don't set them.

# Who may call the function from a browser
ALLOWED_ORIGINS=https://carlos.nz

# Cloudflare Turnstile (secret key — the site key is a GitHub variable)
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=carlos.nz

# openssl rand -base64 48 — salt for the pseudonymous rate-limit hash
RATE_LIMIT_SALT=

# Optional: Resend emails — the submitted form details to you, and a confirmation to the visitor.
# NOTIFY_EMAIL_FROM must be on a domain verified in Resend (carlos.nz).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=carlos.nz <notify@carlos.nz>
