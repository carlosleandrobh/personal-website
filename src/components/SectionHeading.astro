---
import { Icon } from 'astro-icon/components';
interface Props { icon: string; kicker: string; title: string; intro?: string | undefined; id?: string; level?: 'h1' | 'h2' }
const { icon, kicker, title, intro, id, level = 'h2' } = Astro.props;
const Tag = level;
---
<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div class="max-w-2xl">
    <p class="kicker mb-3"><Icon name={icon} class="size-[18px]" aria-hidden="true" />{kicker}</p>
    <Tag id={id} class:list={[level === 'h1' ? 'text-display-m sm:text-display font-extrabold' : 'text-h2-m md:text-h2 font-bold']}>{title}</Tag>
    {intro && <p class="mt-3 text-lg text-muted">{intro}</p>}
  </div>
  <slot />
</div>
