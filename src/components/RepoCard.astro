---
import { Icon } from 'astro-icon/components';
import { monthYear } from '../lib/format';
import type { GithubRepo } from '../lib/types';

interface Props { repo: GithubRepo }
const { repo } = Astro.props;
---
<article class="card card-interactive group relative flex h-full flex-col p-6" data-card>
  <!-- The name comes first, so a screen reader that jumps to the heading hears the owner right after it. The new-tab hint
       is the link's description (aria-describedby), not part of its name, so the list of headings stays clean. -->
  <h3 class="font-display text-lg font-bold">
    <a href={repo.html_url} target="_blank" rel="noopener noreferrer" data-card-link aria-describedby="github-new-tab-hint" class="after:absolute after:inset-0 after:rounded-[var(--radius-card)]">
      {repo.name}
    </a>
  </h3>
  <p class="mt-2 flex items-center justify-between gap-3" data-card-meta>
    <span class="inline-flex items-center gap-2 font-mono text-sm text-subtle">
      <Icon name="simple-icons:github" class="size-4 text-fg" aria-hidden="true" /><span class="sr-only">GitHub repository by </span>{repo.full_name.split('/')[0]}<span class="sr-only">.</span>
    </span>
    {repo.featured && <span class="pill bg-cta/15 text-[#92400e] dark:text-cta">Featured<span class="sr-only">.</span></span>}
  </p>
  <p class="mt-3 line-clamp-3 flex-1 text-[0.9375rem] leading-6 text-muted">{repo.description ?? 'No description yet.'}</p>
  {repo.topics.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Topics">
      {repo.topics.slice(0, 4).map((t) => <li class="chip">{t}</li>)}
    </ul>
  )}
  <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line pt-4 text-sm text-subtle">
    {repo.language && <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>{repo.language}</span>}
    <span class="inline-flex items-center gap-1"><Icon name="material-symbols:star-outline" class="size-4" aria-hidden="true" />{repo.stargazers_count}<span class="sr-only"> stars</span></span>
    {repo.pushed_at && <span>Updated {monthYear(repo.pushed_at)}</span>}
    <span class="ml-auto inline-flex items-center gap-1 font-display text-sm font-semibold text-brand group-hover:underline dark:text-accent">
      View on GitHub <Icon name="material-symbols:open-in-new" class="size-4" aria-hidden="true" />
    </span>
  </p>
</article>
