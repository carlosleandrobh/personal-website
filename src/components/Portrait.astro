---
/**
 * Renders Carlos's portrait if `src/assets/portrait.jpg` exists (create it with
 * `npm run portrait` — the script strips EXIF/GPS metadata first). Until then,
 * a monogram stands in so the layout never breaks.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { alt: string; class?: string; sizes?: string; widths?: number[]; loading?: 'eager' | 'lazy'; initials?: string }
const { alt, class: className, sizes = '(min-width: 1024px) 420px, 80vw', widths = [320, 480, 640, 840], loading = 'eager', initials = 'CL' } = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---
{portrait ? (
  <Picture
    src={portrait}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    class:list={['size-full object-cover', className]}
  />
) : (
  <div class:list={['grid size-full place-items-center bg-gradient-to-b from-accent-tint to-surface', className]} role="img" aria-label={alt}>
    <span class="font-display text-7xl font-extrabold tracking-tight text-brand/80">{initials}</span>
  </div>
)}
