---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-site flex min-h-[60vh] flex-col items-start justify-center gap-6 py-20">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="text-display-m font-extrabold sm:text-display">This bridge doesn't go anywhere.</h1>
    <p class="max-w-xl text-lg text-muted">The page may have moved, or the link has a typo. These will get you back on track:</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/posts/" class="btn btn-secondary">Browse posts</a>
      <a href="/labs/" class="btn btn-secondary">See the labs</a>
    </div>
  </section>
</BaseLayout>
