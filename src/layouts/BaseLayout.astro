---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisplaySettings from '../components/DisplaySettings.astro';
import WelcomeDialog from '../components/WelcomeDialog.astro';
import ListenPlayer from '../components/ListenPlayer.astro';
import { SITE } from '../lib/site';
import { getProfile } from '../lib/content';

interface Props {
  title: string;
  description: string;
  ogImage?: string;           // path, e.g. /og/my-post.png
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string | null;
  noindex?: boolean;
  activeNav?: string;
  /** Open the first-visit welcome window here. Off for pages that are themselves about accessibility. */
  welcome?: boolean;
}

const { title, description, ogImage = '/og/default.png', type = 'website', publishedTime, noindex = false, activeNav, welcome = true } = Astro.props;
const profile = await getProfile();
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogUrl = new URL(ogImage, SITE.url).toString();
const fullTitle = title === SITE.name ? `${profile.display_name} — ${profile.role_line} · Auckland, NZ` : `${title} · ${SITE.name}`;

// Minimal structured data: enough for search engines, nothing personal beyond the public profile.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.display_name,
  url: SITE.url,
  jobTitle: profile.role_line,
  address: { '@type': 'PostalAddress', addressLocality: 'Auckland', addressCountry: 'NZ' },
  sameAs: [profile.linkedin_url, profile.github_username ? `https://github.com/${profile.github_username}` : null].filter(Boolean),
};
---
<!doctype html>
<html lang="en-NZ" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:standard, noai, noimageai'} />
    <!-- EU text-and-data-mining opt-out (TDMRep, DSM Directive art. 4) -->
    <meta name="tdm-reservation" content="1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="carlos.nz posts" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title === SITE.name ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Display settings before first paint (no flash). They stay in this browser only; keep in step with src/scripts/prefs.ts. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var A = {
          theme: ['system', 'light', 'dark', 'high-contrast'],
          text: ['100', '125', '150', '175', '200'],
          spacing: ['normal', 'wide'],
          measure: ['standard', 'narrow'],
          motion: ['system', 'reduce'],
          targets: ['normal', 'large'],
          aloud: ['off', 'on']
        };
        var p = {};
        try { p = JSON.parse(localStorage.getItem('a11y-prefs') || '{}') || {}; } catch (e) {}
        if (typeof p !== 'object') p = {};
        var theme = A.theme.indexOf(p.theme) > -1 ? p.theme : null;
        if (!theme) {
          try {
            var legacy = localStorage.getItem('theme');
            if (legacy === 'light' || legacy === 'dark') theme = legacy;
          } catch (e) {}
        }
        var dark = theme === 'dark' || theme === 'high-contrast' ||
          ((!theme || theme === 'system') && matchMedia('(prefers-color-scheme: dark)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        if (theme === 'high-contrast') d.dataset.contrast = 'high';
        ['text', 'spacing', 'measure', 'motion', 'targets', 'aloud'].forEach(function (k) {
          if (A[k].indexOf(p[k]) > 0) d.dataset[k] = p[k];
        });
      })();
    </script>
    {type !== 'article' && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- The first three Tab stops: skip ahead, adjust how the site looks, or read how it was made accessible.
         Each one appears only while it has focus. "Display settings" is revealed once its script has loaded. -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn-primary">Skip to content</a>
    <button
      type="button"
      data-display-settings-open
      data-reveal="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn-primary"
      aria-haspopup="dialog"
      aria-controls="display-settings"
      class="hidden"
    >Display settings</button>
    <a href="/accessibility/" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn-primary">Accessibility statement</a>
    <Header active={activeNav} />
    <main id="main" tabindex="-1" class="flex-1 overflow-x-clip pt-[80px] focus:outline-none">
      <slot />
    </main>
    <Footer profile={profile} />
    <DisplaySettings />
    {welcome && <WelcomeDialog />}
    <ListenPlayer />
    <script>
      import '../scripts/ui';
      import '../scripts/display-settings';
      import '../scripts/listen';
      import '../scripts/welcome';
    </script>
  </body>
</html>
